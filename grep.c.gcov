        -: 2045:
        -: 2046:#endif /* DEBUG */
        -: 2047:
        -: 2048:/* Same as EXTRACT_NUMBER, except increment SOURCE to after the number.
        -: 2049:   SOURCE must be an lvalue.  */
        -: 2050:
        -: 2051:#define EXTRACT_NUMBER_AND_INCR(destination, source)			\
